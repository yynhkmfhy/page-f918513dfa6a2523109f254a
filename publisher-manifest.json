r:#b8893a;position:absolute;left:0}\n\n.compare{margin-top:2.5rem;background:#fff;border-radius:24px;box-shadow:0 16px 34px -22px rgba(8,32,58,0.18);overflow:hidden}\ntable{width:100%;border-collapse:collapse;font-size:0.92rem}\nth,td{padding:1rem 1.2rem;text-align:left;border-bottom:1px solid #efe9da}\nth{background:#f8f4ea;font-weight:600;color:#08203a;font-size:0.78rem;letter-spacing:0.16em;text-transform:uppercase}\ntr:last-child td{border-bottom:none}\ntd b{color:#08203a}\n\n.faq{margin-top:2.5rem}\n.faq-group{margin-bottom:2rem}\n.faq-group h3{font-size:1rem;letter-spacing:0.1em;color:#b8893a;text-transform:uppercase;margin-bottom:1rem}\ndetails{background:#fff;border-radius:16px;padding:0.9rem 1.2rem;margin-bottom:0.6rem;box-shadow:0 8px 18px -14px rgba(8,32,58,0.15)}\nsummary{cursor:pointer;font-weight:600;color:#08203a;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:1rem}\nsummary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";color:#b8893a;font-size:1.2rem;font-weight:400;transition:transform .2s}\ndetails[open] summary::after{content:\"−\"}\ndetails p{margin:0.8rem 0 0;color:#3b4a63;font-size:0.93rem}\n\n.clients{margin-top:2.5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem}\n.client{background:#fff;border-radius:18px;padding:1.2rem;box-shadow:0 12px 24px -18px rgba(8,32,58,0.15)}\n.client .os{font-size:0.72rem;letter-spacing:0.2em;color:#b8893a;text-transform:uppercase}\n.client h3{margin:0.4rem 0 0.6rem;font-size:1rem}\n.client p{color:#3b4a63;font-size:0.88rem;margin:0}\n\n.foot{padding:3rem 0 4rem;color:#7a8597;font-size:0.82rem;text-align:center}\n\n@media (max-width:860px){\n.hero-grid{grid-template-columns:1fr;gap:2rem}\n.hero-art{min-height:280px}\n.tier{grid-template-columns:1fr}\n.compare{display:block;overflow-x:auto}\n}\n@media (max-width:520px){\n.hero{padding:2.2rem 0 3rem}\nsection{padding:3rem 0}\n.plate{position:relative;margin-bottom:0.8rem}\n.p1,.p2,.p3{position:relative;top:auto;left:auto;right:auto;bottom:auto;width:100%}\n}\n</style><main>\n<header class=\"hero\">\n<div class=\"wrap\">\n<div class=\"hero-grid\">\n<div class=\"hero-text\">\n<span class=\"kicker\">Yunti · 服务说明</span>\n<h1>云梯(Yunti) · 云梯<br>Yunti</h1>\n<p class=\"lede\">按使用场景区分三档套餐，每月或按年付费，清晰写明流量、设备数与节点权限，方便直接对号入座。</p>\n<nav class=\"anchor-tabs\">\n<a href=\"#how\">使用方式</a>\n<a href=\"#plans\">套餐价格</a>\n<a href=\"#compare\">权益对比</a>\n<a href=\"#faq\">常见问题</a>\n</nav>\n</div>\n<div class=\"hero-art\">\n<div class=\"plate p1\">\n<div class=\"lbl\">节点池</div>\n<div class=\"val\">三档入口</div>\n<div class=\"sub\">按套餐解锁范围</div>\n</div>\n<div class=\"plate p2\">\n<div class=\"lbl\">本月已选</div>\n<div class=\"val\">旗舰版</div>\n<div class=\"sub\">5 台设备 · IPLC</div>\n</div>\n<div class=\"plate p3\">\n<div class=\"lbl\">流量进度</div>\n<div class=\"val\">186 / 300 GB</div>\n<div class=\"meter\"><span></span></div>\n<div class=\"sub\">周期内累积用量</div>\n</div>\n</div>\n</div>\n</div>\n</header>\n\n<section id=\"how\">\n<div class=\"wrap\">\n<div class=\"eyebrow\">使用方式</div>\n<h2>从订阅到连接的四个步骤</h2>\n<p class=\"lead\">订阅后通过订阅链接添加节点，所有步骤均在客户端内完成，不依赖额外脚本或外部服务。</p>\n<div class=\"flow\">\n<div class=\"step\">\n<div class=\"n\">01</div>\n<div>\n<h3>选择套餐</h3>\n<p>在套餐页面确定流量额度与设备数，并选定支付周期（按月或按年）。</p>\n</div>\n</div>\n<div class=\"step\">\n<div class=\"n\">02</div>\n<div>\n<h3>获取订阅链接</h3>\n<p>支付完成后，在用户中心复制对应套餐的订阅链接，链接包含节点信息与权限标识。</p>\n</div>\n</div>\n<div class=\"step\">\n<div class=\"n\">03</div>\n<div>\n<h3>导入客户端</h3>\n<p>将订阅链接粘贴至所选设备的客户端，由其自动同步节点列表与延迟信息。</p>\n</div>\n</div>\n<div class=\"step\">\n<div class=\"n\">04</div>\n<div>\n<h3>选择节点连接</h3>\n<p>在客户端中按需挑选节点，关注延迟与用途标签即可，套餐权限决定可选范围。</p>\n</div>\n</div>\n</div>\n</div>\n</section>\n\n<section id=\"plans\">\n<div class=\"wrap\">\n<div class=\"eyebrow\">套餐价格</div>\n<h2>阶梯式三档，按需选择</h2>\n<p class=\"lead\">从基础到团队，价格、流量与设备数依次提升；按年付费较按月一次性结算。</p>\n<div class=\"ladder\">\n<article class=\"tier\">\n<div class=\"head\">\n<span class=\"tag\">入门</span>\n<h3>基础版</h3>\n<div class=\"price\"><b>¥15</b><small>/月</small></div>\n<small>按年付仅需 ¥150/年</small>\n</div>\n<ul class=\"feats\">\n<li>每月 100GB 极速流量</li>\n<li>支持 3 台设备同时在线</li>\n<li>解锁基础流媒体</li>\n<li>普通线路节点池</li>\n</ul>\n</article>\n<article class=\"tier featured\">\n<div class=\"head\">\n<span class=\"tag\">推荐</span>\n<h3>旗舰版</h3>\n<div class=\"price\"><b>¥35</b><small>/月</small></div>\n<small>按年付仅需 ¥350/年</small>\n</div>\n<ul class=\"feats\">\n<li>每月 300GB 极速流量</li>\n<li>支持 5 台设备同时在线</li>\n<li>全节点原生流媒体解锁</li>\n<li>IPLC 专线游戏加速优化</li>\n<li>7x24 优先工单支持</li>\n</ul>\n</article>\n<article class=\"tier\">\n<div class=\"head\">\n<span class=\"tag\">企业</span>\n<h3>团队版</h3>\n<div class=\"price\"><b>¥85</b><small>/月</small></div>\n<small>按年付仅需 ¥850/年</small>\n</div>\n<ul class=\"feats\">\n<li>每月 1000GB 极速流量</li>\n<li>支持 20 台设备同时在线</li>\n<li>VIP 专属高带宽节点</li>\n<li>支持企业定制路由</li>\n<li>专属客户经理服务</li>\n</ul>\n</article>\n</div>\n</div>\n</section>\n\n<section id=\"compare\">\n<div class=\"wrap\">\n<div class=\"eyebrow\">权益对比</div>\n<h2>三档差异一览</h2>\n<p class=\"lead\">以下条目按常见选购维度排列，方便横向比对。</p>\n<div class=\"compare\">\n<table>\n<thead>\n<tr><th>对比项</th><th>基础版</th><th>旗舰版</th><th>团队版</th></tr>\n</thead>\n<tbody>\n<tr><td><b>月流量</b></td><td>100 GB</td><td>300 GB</td><td>1000 GB</td></tr>\n<tr><td><b>同时在线</b></td><td>3 台</td><td>5 台</td><td>20 台</td></tr>\n<tr><td><b>流媒体解锁</b></td><td>基础</td><td>原生全节点</td><td>原生全节点</td></tr>\n<tr><td><b>专线优化</b></td><td>—</td><td>IPLC 游戏加速</td><td>企业定制路由</td></tr>\n<tr><td><b>客户支持</b></td><td>常规工单</td><td>7x24 优先工单</td><td>专属客户经理</td></tr>\n<tr><td><b>月付价格</b></td><td>¥15</td><td>¥35</td><td>¥85</td></tr>\n<tr><td><b>年付价格</b></td><td>¥150</td><td>¥350</td><td>¥850</td></tr>\n</tbody>\n</table>\n</div>\n</div>\n</section>\n\n<section id=\"clients\">\n<div class=\"wrap\">\n<div class=\"eyebrow\">客户端与平台</div>\n<h2>可在多平台使用</h2>\n<p class=\"lead\">订阅链接与主流客户端兼容，具体可用软件视系统而定，请以设备当前可安装的应用为准。</p>\n<div class=\"clients\">\n<article class=\"client\">\n<div class=\"os\">Windows</div>\n<h3>桌面端</h3>\n<p>适用于 Windows 系统的桌面客户端，安装后导入订阅链接即可同步节点。</p>\n</article>\n<article class=\"client\">\n<div class=\"os\">macOS</div>\n<h3>桌面端</h3>\n<p>适用于 macOS 的桌面客户端，与其他平台共用同一订阅地址。</p>\n</article>\n<article class=\"client\">\n<div class=\"os\">iOS</div>\n<h3>移动端</h3>\n<p>在 iOS 设备上可通过对应移动客户端添加订阅，按系统提示完成配置。</p>\n</article>\n<article class=\"client\">\n<div class=\"os\">Android</div>\n<h3>移动端</h3>\n<p>Android 设备支持常见移动客户端，请以应用商店实际可下载版本为准。</p>\n</article>\n</div>\n</div>\n</section>\n\n<section id=\"faq\">\n<div class=\"wrap\">\n<div class=\"eyebrow\">常见问题</div>\n<h2>按主题分组</h2>\n<p class=\"lead\">下单、配置与套餐相关的常见疑问整理如下，如仍有未覆盖之处，可咨询页面内提供的支持渠道。</p>\n<div class=\"faq\">\n<div class=\"faq-group\">\n<h3>套餐与计费</h3>\n<details>\n<summary>按月和按年付费有什么区别？</summary>\n<p>两者提供的节点与权限完全一致，仅结算方式不同：按月付款灵活，按年付款为整年一次性结算，金额在套餐页已明确列出。</p>\n</details>\n<details>\n<summary>套餐之间可以升级或降级吗？</summary>\n<p>可以。在当前周期结束后，可选择切换至其他档位，新周期按所选档位的费用结算，订阅链接与权限将同步刷新。</p>\n</details>\n<details>\n<summary>流量是如何计算的？</summary>\n<p>流量按自然月累计统计，所有通过节点产生的上下行流量均计入用量，可在用户中心查看周期内的实时进度。</p>\n</details>\n</div>\n<div class=\"faq-group\">\n<h3>设备与节点</h3>\n<details>\n<summary>支持多少台设备同时在线？</summary>\n<p>基础版支持 3 台，旗舰版支持 5 台，团队版支持 20 台，可在用户中心查看当前登录设备的占用情况。</p>\n</details>\n<details>\n<summary>是否区分节点类型？</summary>\n<p>区分。基础版对应普通线路节点池，旗舰版在普通节点之上加入 IPLC 专线，团队版提供专属高带宽节点与企业定制路由。</p>\n</details>\n<details>\n<summary>设备更换平台需要重新订阅吗？</summary>\n<p>不需要。订阅链接与平台无关，在任意支持的客户端内粘贴同一链接即可拉取对应的节点列表。</p>\n</details>\n</div>\n<div class=\"faq-group\">\n<h3>使用与支持</h3>\n<details>\n<summary>流媒体解锁支持哪些服务？</summary>\n<p>基础版支持基础类流媒体，旗舰版与团队版在此基础上提供更完整的原生解锁范围，具体以客户端内显示为准。</p>\n</details>\n<details>\n<summary>遇到问题如何获得帮助？</summary>\n<p>旗舰版提供 7x24 优先工单支持，团队版配备专属客户经理，基础版走常规工单处理流程。</p>\n</details>\n<details>\n<summary>是否提供退款？</summary>\n<p>退款规则以购买页与协议中公示的条款为准，建议在购买前仔细阅读相关说明。</p>\n</details>\n</div>\n</div>\n</div>\n</section>\n\n<footer class=\"foot\">\n<div class=\"wrap\">云梯 Yunti · 以上价格、内容及权益以本页与购买页说明为准。</div>\n</footer>\n</main>",
